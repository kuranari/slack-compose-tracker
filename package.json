{
	"name": "slack-compose-tracker",
	"description": "Slackメッセージ作成時間トラッカー",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox",
		"postinstall": "wxt prepare",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"check": "npm run typecheck && npm run lint",
		"test": "vitest run",
		"test:watch": "vitest",
		"e2e:install": "playwright install chromium",
		"e2e:login": "wxt build && playwright test --project=login",
		"e2e": "wxt build && playwright test --project=e2e"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@playwright/test": "1.64.1",
		"@types/node": "26.6.6",
		"typescript": "^5.9.3",
		"vite": "^8.1.5",
		"vitest": "5.0.5",
		"web-ext": "^10.5.0",
		"wxt": "^0.21.3"
	}
}
