{
	"permissions": {
		"allow": ["Bash(npm run *)", "Bash(npm test *)"]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "cd \"$CLAUDE_PROJECT_DIR\" && npm run --silent check >&2 || exit 2"
					}
				]
			}
		]
	}
}
